# GRIT NEWS Environment Variables
# Public browser configuration (safe to expose)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_GTM_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=

# Identidade administrativa global GRIT (não é segredo; a senha nunca deve ir para o repositório)
GRIT_SUPERADMIN_EMAIL=gritsolucoes@gmail.com

# Backend-only Supabase
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Mercado Pago (backend only)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token-here
MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key-here
RECEIPT_SALT=

# Meta Ads / Conversions API (backend or Vault only)
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_ADS_ACCESS_TOKEN=

# WhatsApp Business Platform (backend or Vault only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Ads OAuth/API (backend or Vault only)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google conversion labels (identifiers, not secrets)
GOOGLE_ADS_START_TRIAL_LABEL=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_ACTIVATION_LABEL=
GOOGLE_ADS_SUBSCRIPTION_LABEL=

# Never prefix secrets, service-role keys, access tokens or refresh tokens with VITE_.
