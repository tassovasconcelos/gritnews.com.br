Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Roteamento estatico exclusivo do subdominio uniao.gritnews.com.br
RewriteRule ^login/?$ acesso.html [L,QSA,NC]
RewriteRule ^admin/?$ index.html [L,QSA,NC]
RewriteRule ^equipe/?$ index.html [L,QSA,NC]
RewriteRule ^proprietario/?$ index.html [L,QSA,NC]
RewriteRule ^health/?$ health.json [L,QSA,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
</IfModule>
