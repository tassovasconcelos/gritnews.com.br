AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
Options -Indexes
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set X-Frame-Options "DENY"
 Header always set Strict-Transport-Security "max-age=31536000"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://pcrwtoddavpvkaxwtstc.supabase.co; connect-src 'self' https://pcrwtoddavpvkaxwtstc.supabase.co wss://pcrwtoddavpvkaxwtstc.supabase.co https://pncp.gov.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
 <FilesMatch "\.(html|js|mjs|json|webmanifest|css|png|jpg)$">
  Header always set Cache-Control "no-cache, must-revalidate"
  Header always unset Expires
 </FilesMatch>
 <FilesMatch "^(ativar|recuperar)\.html$">
  Header always set Cache-Control "no-store"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src https://pcrwtoddavpvkaxwtstc.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json
</IfModule>
